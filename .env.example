GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
CONNECTCIRCLE_SESSION_SECRET=replace-this-with-a-long-random-string
CONNECTCIRCLE_ADMIN_SESSION_SECRET=replace-this-with-a-different-long-random-string
CONNECTCIRCLE_ADMIN_USERNAME=owner_admin
CONNECTCIRCLE_ADMIN_PASSWORD=replace-this-with-a-long-admin-password
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
DATABASE_URL=postgres://user:password@host/database?sslmode=require
CONNECTCIRCLE_REQUIRE_DATABASE=false
RESEND_API_KEY=your-resend-api-key
FEEDBACK_EMAIL_TO=your-email@example.com
FEEDBACK_EMAIL_FROM=ConnectCircle <feedback@your-domain.com>
